{
  "version": 2,
  "builds": [
    {
      "src": "api/send.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/visit.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/send",
      "dest": "/api/send.js"
    },
    {
      "src": "/api/send",
      "dest": "/api/send.js"
    },
    {
      "src": "/visit",
      "dest": "/api/visit.js"
    },
    {
      "src": "/api/visit",
      "dest": "/api/visit.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/send.js",
      "methods": ["OPTIONS"]
    }
  ]
}